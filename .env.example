# MINNING — backend environment
# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# All variables use the MINNING prefix; dot/dash keys map to '_' in config.go.

# ── Runtime ────────────────────────────────────────────────────────────────────
# Profile: development | staging | production (required)
MINNING_ENV=development

# ── HTTP server ────────────────────────────────────────────────────────────────
MINNING_HTTP_HOST=
MINNING_HTTP_PORT=8080
# Comma-separated CORS allowlist — REQUIRED in production
MINNING_HTTP_ALLOWED_ORIGINS=http://localhost:4200
# Go durations
MINNING_HTTP_READ_TIMEOUT=30s
MINNING_HTTP_WRITE_TIMEOUT=30s

# ── PostgreSQL ────────────────────────────────────────────────────────────────
MINNING_DB_HOST=localhost
MINNING_DB_PORT=5432
MINNING_DB_NAME=minning
MINNING_DB_USER=postgres
# ── Secrets (env ONLY — never in config.yaml) ─────────────────────────────────
# PostgreSQL role password (tx manager / pools)
MINNING_DB_PASSWORD=
# SSL mode: disable | require | verify-full (default require)
MINNING_DB_SSLMODE=require
# 0 or negative = driver default
MINNING_DB_MAX_CONNS=10
MINNING_DB_MIN_CONNS=1

# ── Structured logger ────────────────────────────────────────────
# json | text
MINNING_LOG_FORMAT=text
# debug | info | warn | error (required)
MINNING_LOG_LEVEL=debug

# ── Migration configuration ────────────────────────────────────────────
MINNING_MIGRATION_DIR_PATH=migrations/
MINNING_MIGRATION_PLACEHOLDERS=


# ── Frontend ────────────────────────────────────────────
API_URL=https://mining-equipment-test.vercel.app/api/v1